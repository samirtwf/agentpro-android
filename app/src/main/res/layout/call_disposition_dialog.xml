<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/shape_disposition_card"
    android:padding="20dp"
    android:layoutDirection="ltr">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/checks"
            android:background="@drawable/shape_disposition_button"
            app:tint="#9B5CF6" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ap_call_disposition"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/disp_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ap_call"
                android:textColor="#8A8F98"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/disp_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#9B8CFF"
            android:textSize="14sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/shape_purple_badge_background" />

        <TextView
            android:id="@+id/disp_close"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#8A8F98"
            android:textSize="18sp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/disp_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp" />

    <LinearLayout
        android:id="@+id/disp_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp" />

    <!-- Notes -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ap_notes"
        android:textColor="#8A8F98"
        android:textSize="14sp"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/disp_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/ap_add_notes_about_this_call"
        android:textColorHint="#5A616E"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:gravity="top|start"
        android:minLines="3"
        android:maxLines="5"
        android:padding="14dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/shape_disposition_button"
        android:inputType="textMultiLine|textCapSentences"
        android:importantForAutofill="no" />

    <TextView
        android:id="@+id/disp_save"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="center"
        android:text="@string/ap_save_disposition"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:background="@drawable/shape_gradient_button"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
