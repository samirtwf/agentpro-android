<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View" />
        <variable name="digit" type="String" />
        <variable name="letters" type="String" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?selectableItemBackgroundBorderless"
        android:background="@drawable/shape_dark_circle">

        <!-- Digit + letters kept together and centered as a group, so the keypad
             stays readable and uncramped at any button size. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/digit_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{digit}"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:maxLines="1"
                android:includeFontPadding="false" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/letters_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@{letters}"
                android:textColor="#9AA0A8"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:visibility="@{letters.empty ? View.GONE : View.VISIBLE}" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
