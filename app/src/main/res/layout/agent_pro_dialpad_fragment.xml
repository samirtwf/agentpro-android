<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable name="viewModel" type="org.linphone.ui.main.viewmodel.AbstractMainViewModel" />
        <variable name="dialpadViewModel" type="org.linphone.ui.main.history.viewmodel.StartCallViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"
        android:background="#12151B">

        <!-- Top Bar -->
        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ap_agentpro"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Status Badges -->
        <TextView
            android:id="@+id/status_connected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{viewModel.account != null ? viewModel.account.registrationStateLabel : @string/ap_disconnected}"
            android:textColor="#2ECC71"
            android:textSize="14sp"
            android:drawableStart="@drawable/ic_dot_green"
            android:drawablePadding="7dp"
            android:background="@drawable/shape_green_badge_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/app_title"
            app:layout_constraintStart_toStartOf="@id/app_title"
            tools:text="Connected" />

        <TextView
            android:id="@+id/status_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{viewModel.account != null &amp;&amp; viewModel.account.account.params.identityAddress != null ? viewModel.account.account.params.identityAddress.username : @string/ap_no_account}"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:drawableStart="@drawable/phone_transfer"
            android:drawablePadding="7dp"
            app:drawableTint="#8AA0FF"
            android:background="@drawable/shape_purple_badge_background"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="@id/status_connected"
            app:layout_constraintTop_toTopOf="@id/status_connected"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="5559" />

        <!-- Optional white-label company logo (next to the extension number). Loaded at runtime
             from assets/company_logo.png by the APK Builder; hidden when the build has no logo. -->
        <ImageView
            android:id="@+id/company_logo"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:adjustViewBounds="true"
            android:maxWidth="120dp"
            android:visibility="gone"
            android:contentDescription="@string/ap_company_logo"
            android:layout_marginEnd="10dp"
            app:layout_constraintTop_toTopOf="@id/status_id"
            app:layout_constraintBottom_toBottomOf="@id/status_id"
            app:layout_constraintEnd_toStartOf="@id/status_id" />

        <TextView
            android:id="@+id/status_server"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ap_no_server"
            android:textColor="#757575"
            android:textSize="14sp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/status_connected"
            app:layout_constraintStart_toStartOf="@id/app_title"
            tools:text="pbx.example.com:5061 via TLS" />

        <TextView
            android:id="@+id/status_uptime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ap_uptime_00_00_00_idle_00_00"
            android:textColor="#757575"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/status_server"
            app:layout_constraintStart_toStartOf="@id/app_title" />

        <!-- Input Field -->
        <EditText
            android:id="@+id/phone_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/ap_enter_number"
            android:textColorHint="#3A3F47"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:gravity="center"
            android:background="@null"
            android:includeFontPadding="false"
            android:layout_marginTop="2dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:maxLines="1"
            android:inputType="phone"
            android:importantForAutofill="no"
            app:layout_constraintTop_toBottomOf="@id/status_uptime"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Speed Dial Row: the + stays fixed top-right. The prompt text shows when there
             are no shortcuts and is REPLACED in-place by the chips strip when there are,
             so the keypad below keeps (almost) the same height in both states. -->
        <ImageView
            android:id="@+id/speed_dial_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/plus_circle"
            android:background="?selectableItemBackgroundBorderless"
            app:tint="#3498DB"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintTop_toBottomOf="@id/phone_input"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/speed_dial_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ap_tap_to_add_speed_dial"
            android:textColor="#757575"
            android:textSize="14sp"
            app:layout_constraintTop_toTopOf="@id/speed_dial_add"
            app:layout_constraintBottom_toBottomOf="@id/speed_dial_add"
            app:layout_constraintStart_toStartOf="@id/app_title"
            app:layout_constraintEnd_toStartOf="@id/speed_dial_add" />

        <HorizontalScrollView
            android:id="@+id/speed_dial_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/phone_input"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/speed_dial_add"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/speed_dial_list"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="8dp" />
        </HorizontalScrollView>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/speed_dial_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:barrierAllowsGoneWidgets="false"
            app:constraint_referenced_ids="speed_dial_add,speed_dial_text,speed_dial_scroll" />

        <!-- Bottom Navigation -->
        <include
            android:id="@+id/bottom_nav_bar"
            layout="@layout/bottom_nav_bar"
            app:viewModel="@{viewModel}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Toggles Row -->
        <LinearLayout
            android:id="@+id/toggles_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/shape_dark_rounded_rect"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_nav_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/dnd_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/ap_dnd"
                android:textColor="#E74C3C"
                android:textSize="12sp"
                android:drawableStart="@drawable/ic_dot_red"
                android:drawablePadding="3dp"
                android:maxLines="1" />
            <CheckBox
                android:id="@+id/chk_dnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:buttonTint="#E74C3C" />

            <ImageView
                android:id="@+id/dnd_timer"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="3dp"
                android:layout_marginStart="1dp"
                android:src="@drawable/clock_countdown"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/ap_dnd_timer"
                app:tint="#757575" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/auto_ans_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/ap_auto_ans"
                android:textColor="#2ECC71"
                android:textSize="12sp"
                android:drawableStart="@drawable/ic_dot_green"
                android:drawablePadding="3dp"
                android:maxLines="1" />
            <CheckBox
                android:id="@+id/chk_auto_ans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:buttonTint="#2ECC71" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/auto_disp_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/ap_auto_disp"
                android:textColor="#757575"
                android:textSize="12sp"
                android:maxLines="1" />
            <CheckBox
                android:id="@+id/chk_auto_disp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:buttonTint="#757575" />
        </LinearLayout>

        <!-- Actions Row -->
        <ImageView
            android:id="@+id/btn_call"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/phone_call"
            android:padding="18dp"
            android:background="@drawable/shape_green_circle"
            app:tint="#FFFFFF"
            android:layout_marginBottom="14dp"
            app:layout_constraintBottom_toTopOf="@id/toggles_row"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/btn_refresh"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/arrow_clockwise"
            android:padding="15dp"
            android:background="@drawable/shape_dark_circle"
            app:tint="#9AA0A8"
            android:layout_marginEnd="32dp"
            app:layout_constraintTop_toTopOf="@id/btn_call"
            app:layout_constraintBottom_toBottomOf="@id/btn_call"
            app:layout_constraintEnd_toStartOf="@id/btn_call" />

        <ImageView
            android:id="@+id/btn_delete"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/backspace_fill"
            android:padding="15dp"
            android:background="?selectableItemBackgroundBorderless"
            app:tint="#9AA0A8"
            android:layout_marginStart="32dp"
            app:layout_constraintTop_toTopOf="@id/btn_call"
            app:layout_constraintBottom_toBottomOf="@id/btn_call"
            app:layout_constraintStart_toEndOf="@id/btn_call" />

        <!-- Dialpad Grid: fills the space between the speed-dial row and the call button.
             Each button's height is driven by its row cell and the width follows via a
             1:1 ratio (W,1:1), so buttons are always circular and scale to fit both the
             width and the height of any screen. Columns are centred on percentage
             guidelines so the keypad also scales horizontally. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dialpad_grid"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintTop_toBottomOf="@id/speed_dial_barrier"
            app:layout_constraintBottom_toTopOf="@id/btn_call"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Column centre guidelines -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_c1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" app:layout_constraintGuide_percent="0.23" />
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_c2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" app:layout_constraintGuide_percent="0.5" />
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_c3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" app:layout_constraintGuide_percent="0.77" />

            <!-- Row boundary guidelines -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_r1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" app:layout_constraintGuide_percent="0.25" />
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_r2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" app:layout_constraintGuide_percent="0.5" />
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_r3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" app:layout_constraintGuide_percent="0.75" />

            <!-- Row 1 -->
            <include layout="@layout/dialpad_button" android:id="@+id/btn_1"
                android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                app:layout_constraintDimensionRatio="W,1:1" app:digit="@{`1`}" app:letters="@{``}"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/gl_r1"
                app:layout_constraintStart_toStartOf="@id/gl_c1" app:layout_constraintEnd_toEndOf="@id/gl_c1" />
            <include layout="@layout/dialpad_button" android:id="@+id/btn_2"
                android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                app:layout_constraintDimensionRatio="W,1:1" app:digit="@{`2`}" app:letters="@{`ABC`}"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/gl_r1"
                app:layout_constraintStart_toStartOf="@id/gl_c2" app:layout_constraintEnd_toEndOf="@id/gl_c2" />
            <include layout="@layout/dialpad_button" android:id="@+id/btn_3"
                android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                app:layout_constraintDimensionRatio="W,1:1" app:digit="@{`3`}" app:letters="@{`DEF`}"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/gl_r1"
                app:layout_constraintStart_toStartOf="@id/gl_c3" app:layout_constraintEnd_toEndOf="@id/gl_c3" />

            <!-- Row 2 -->
            <include layout="@layout/dialpad_button" android:id="@+id/btn_4"
                android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                app:layout_constraintDimensionRatio="W,1:1" app:digit="@{`4`}" app:letters="@{`GHI`}"
                app:layout_constraintTop_toBottomOf="@id/gl_r1" app:layout_constraintBottom_toTopOf="@id/gl_r2"
                app:layout_constraintStart_toStartOf="@id/gl_c1" app:layout_constraintEnd_toEndOf="@id/gl_c1" />
            <include layout="@layout/dialpad_button" android:id="@+id/btn_5"
                android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                app:layout_constraintDimensionRatio="W,1:1" app:digit="@{`5`}" app:letters="@{`JKL`}"
                app:layout_constraintTop_toBottomOf="@id/gl_r1" app:layout_constraintBottom_toTopOf="@id/gl_r2"
                app:layout_constraintStart_toStartOf="@id/gl_c2" app:layout_constraintEnd_toEndOf="@id/gl_c2" />
            <include layout="@layout/dialpad_button" android:id="@+id/btn_6"
                android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                app:layout_constraintDimensionRatio="W,1:1" app:digit="@{`6`}" app:letters="@{`MNO`}"
                app:layout_constraintTop_toBottomOf="@id/gl_r1" app:layout_constraintBottom_toTopOf="@id/gl_r2"
                app:layout_constraintStart_toStartOf="@id/gl_c3" app:layout_constraintEnd_toEndOf="@id/gl_c3" />

            <!-- Row 3 -->
            <include layout="@layout/dialpad_button" android:id="@+id/btn_7"
                android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                app:layout_constraintDimensionRatio="W,1:1" app:digit="@{`7`}" app:letters="@{`PQRS`}"
                app:layout_constraintTop_toBottomOf="@id/gl_r2" app:layout_constraintBottom_toTopOf="@id/gl_r3"
                app:layout_constraintStart_toStartOf="@id/gl_c1" app:layout_constraintEnd_toEndOf="@id/gl_c1" />
            <include layout="@layout/dialpad_button" android:id="@+id/btn_8"
                android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                app:layout_constraintDimensionRatio="W,1:1" app:digit="@{`8`}" app:letters="@{`TUV`}"
                app:layout_constraintTop_toBottomOf="@id/gl_r2" app:layout_constraintBottom_toTopOf="@id/gl_r3"
                app:layout_constraintStart_toStartOf="@id/gl_c2" app:layout_constraintEnd_toEndOf="@id/gl_c2" />
            <include layout="@layout/dialpad_button" android:id="@+id/btn_9"
                android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                app:layout_constraintDimensionRatio="W,1:1" app:digit="@{`9`}" app:letters="@{`WXYZ`}"
                app:layout_constraintTop_toBottomOf="@id/gl_r2" app:layout_constraintBottom_toTopOf="@id/gl_r3"
                app:layout_constraintStart_toStartOf="@id/gl_c3" app:layout_constraintEnd_toEndOf="@id/gl_c3" />

            <!-- Row 4 -->
            <include layout="@layout/dialpad_button" android:id="@+id/btn_star"
                android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                app:layout_constraintDimensionRatio="W,1:1" app:digit="@{`*`}" app:letters="@{``}"
                app:layout_constraintTop_toBottomOf="@id/gl_r3" app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/gl_c1" app:layout_constraintEnd_toEndOf="@id/gl_c1" />
            <include layout="@layout/dialpad_button" android:id="@+id/btn_0"
                android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                app:layout_constraintDimensionRatio="W,1:1" app:digit="@{`0`}" app:letters="@{`+`}"
                app:layout_constraintTop_toBottomOf="@id/gl_r3" app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/gl_c2" app:layout_constraintEnd_toEndOf="@id/gl_c2" />
            <include layout="@layout/dialpad_button" android:id="@+id/btn_hash"
                android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                app:layout_constraintDimensionRatio="W,1:1" app:digit="@{`#`}" app:letters="@{``}"
                app:layout_constraintTop_toBottomOf="@id/gl_r3" app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/gl_c3" app:layout_constraintEnd_toEndOf="@id/gl_c3" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
