<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable name="viewModel" type="org.linphone.ui.main.viewmodel.AbstractMainViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"
        android:background="#12151B">

        <!-- Header + filters section -->
        <LinearLayout
            android:id="@+id/disp_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#191C2B"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Title row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ap_dispositions"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/disp_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ap_0_records"
                        android:textColor="#6C8CFF"
                        android:textSize="12sp"
                        tools:text="1 record" />
                </LinearLayout>

                <TextView
                    android:id="@+id/disp_export"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ap_export"
                    android:textColor="#8AA0FF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:background="@drawable/shape_disposition_button"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/disp_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/ap_clear_2"
                    android:textColor="#E74C3C"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Search -->
            <EditText
                android:id="@+id/disp_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/ap_search_number_or_notes"
                android:textColorHint="#5A616E"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:background="@drawable/shape_disposition_button"
                android:maxLines="1"
                android:inputType="text"
                android:importantForAutofill="no" />

            <!-- Category row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ap_category"
                    android:textColor="#6C8CFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/disp_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ap_all"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="9dp"
                    android:background="@drawable/shape_disposition_button"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/ap_tap_row_call"
                    android:textColor="#5A616E"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Sort row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ap_sort"
                    android:textColor="#6C8CFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/disp_sort_date"
                    style="@style/disp_sort_chip"
                    android:text="@string/ap_date" />

                <TextView
                    android:id="@+id/disp_sort_number"
                    style="@style/disp_sort_chip"
                    android:text="@string/ap_number" />

                <TextView
                    android:id="@+id/disp_sort_status"
                    style="@style/disp_sort_chip"
                    android:text="@string/ap_status_2" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/disp_recycler"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toBottomOf="@id/disp_header"
            app:layout_constraintBottom_toTopOf="@id/bottom_nav_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/disp_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ap_no_dispositions_yet"
            android:textColor="#5A616E"
            android:textSize="15sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/disp_header"
            app:layout_constraintBottom_toTopOf="@id/bottom_nav_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <include
            android:id="@+id/bottom_nav_bar"
            layout="@layout/bottom_nav_bar"
            app:viewModel="@{viewModel}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
