<?xml version="1.0" encoding="utf-8"?>
<!-- AgentPro Accounts manager: list every SIP account, switch the active one (applies its account
     + its own PBX settings everywhere), add a new one, or remove one. Rows are built at runtime. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12151B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/accounts_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ap_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginEnd="40dp"
                android:text="@string/ap_accounts"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ap_tap_an_account_to_make_it_active_its_sip"
            android:textColor="#7C8696"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="8dp" />

        <!-- Account rows are added here at runtime -->
        <LinearLayout
            android:id="@+id/accounts_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/accounts_add"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:drawablePadding="16dp"
            android:text="@string/ap_add_account"
            android:textColor="#5AA0FF"
            android:textSize="16sp"
            android:background="@drawable/squircle_transparent_button_background"
            android:drawableStart="@drawable/plus_circle"
            android:drawableTint="#5AA0FF"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
