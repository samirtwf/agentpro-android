<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable name="viewModel" type="org.linphone.ui.main.viewmodel.AbstractMainViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"
        android:background="#12151B">

        <LinearLayout
            android:id="@+id/cdr_top"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ap_cdr"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/cdr_settings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:padding="6dp"
                    android:src="@drawable/gear"
                    app:tint="#C7CDD6"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/ap_pbx_web_settings" />

                <TextView
                    android:id="@+id/cdr_open_web"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/ap_pbx_page"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/shape_btn_blue"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/cdr_export"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/ap_export"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/shape_btn_green"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView android:id="@+id/cdr_from" style="@style/campaign_action_btn"
                    android:textColor="#C7CDD6" android:text="@string/ap_from" android:background="@drawable/shape_btn_gray" />
                <TextView android:id="@+id/cdr_to" style="@style/campaign_action_btn"
                    android:layout_marginStart="6dp" android:textColor="#C7CDD6" android:text="@string/ap_to" android:background="@drawable/shape_btn_gray" />
                <TextView android:id="@+id/cdr_load" style="@style/campaign_action_btn"
                    android:layout_marginStart="6dp" android:text="@string/ap_load" android:background="@drawable/shape_btn_blue" />
            </LinearLayout>

            <EditText
                android:id="@+id/cdr_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/ap_filter_by_number"
                android:textColorHint="#5A616E"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="9dp"
                android:background="@drawable/shape_disposition_button"
                android:maxLines="1"
                android:inputType="phone"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/cdr_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textColor="#6E7681"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cdr_recycler"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            app:layout_constraintTop_toBottomOf="@id/cdr_top"
            app:layout_constraintBottom_toTopOf="@id/bottom_nav_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/cdr_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/ap_tap_load_to_fetch_call_records"
            android:textColor="#5A616E"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/cdr_top"
            app:layout_constraintBottom_toTopOf="@id/bottom_nav_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <include
            android:id="@+id/bottom_nav_bar"
            layout="@layout/bottom_nav_bar"
            app:viewModel="@{viewModel}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
