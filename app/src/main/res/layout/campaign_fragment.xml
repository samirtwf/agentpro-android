<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable name="viewModel" type="org.linphone.ui.main.viewmodel.AbstractMainViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"
        android:background="#12151B">

        <LinearLayout
            android:id="@+id/campaign_top"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Title -->
            <TextView
                android:id="@+id/campaign_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ap_campaign"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/list"
                android:drawablePadding="8dp"
                app:drawableTint="#8AA0FF" />

            <!-- Action buttons row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView android:id="@+id/btn_import" style="@style/campaign_action_btn"
                    android:text="@string/ap_import" android:background="@drawable/shape_btn_green" />
                <TextView android:id="@+id/btn_export" style="@style/campaign_action_btn"
                    android:layout_marginStart="6dp" android:text="@string/ap_export" android:background="@drawable/shape_btn_blue" />
                <TextView android:id="@+id/btn_clear" style="@style/campaign_action_btn"
                    android:layout_marginStart="6dp" android:text="@string/ap_clear" android:background="@drawable/shape_btn_gray" />
                <TextView android:id="@+id/btn_reset" style="@style/campaign_action_btn"
                    android:layout_marginStart="6dp" android:text="@string/ap_reset" android:background="@drawable/shape_btn_orange" />
            </LinearLayout>

            <!-- Download a blank Excel template to fill in and re-import -->
            <TextView
                android:id="@+id/btn_template"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/ap_download_excel_template"
                android:textColor="#8AA0FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/shape_disposition_button"
                android:clickable="true"
                android:focusable="true" />

            <!-- Action buttons row 2 (auto-dialer; hidden on the Contacts screen) -->
            <LinearLayout
                android:id="@+id/campaign_dialer_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView android:id="@+id/btn_start" style="@style/campaign_action_btn"
                    android:text="@string/ap_start" android:background="@drawable/shape_btn_green"
                    android:drawableStart="@drawable/play_fill" />
                <TextView android:id="@+id/btn_stop" style="@style/campaign_action_btn"
                    android:layout_marginStart="6dp" android:text="@string/ap_stop" android:textColor="#E74C3C"
                    android:background="@drawable/shape_btn_gray"
                    android:drawableStart="@drawable/pause_fill" android:drawableTint="#E74C3C" />
                <TextView android:id="@+id/btn_delay"
                    android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1.3"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:text="@string/ap_10s_delay"
                    android:textColor="#C7CDD6"
                    android:textSize="12sp"
                    android:background="@drawable/shape_btn_gray"
                    android:clickable="true" android:focusable="true" />
            </LinearLayout>

            <!-- Scheduled callbacks bar -->
            <LinearLayout
                android:id="@+id/campaign_callbacks_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:padding="8dp"
                android:background="@drawable/shape_disposition_button">

                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:src="@drawable/clock" app:tint="#8AA0FF" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp"
                    android:text="@string/ap_scheduled_callbacks" android:textColor="#FFFFFF" android:textSize="13sp" />
                <TextView android:id="@+id/campaign_callbacks_count"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="24dp" android:gravity="center"
                    android:text="0" android:textColor="#FFFFFF" android:textSize="11sp"
                    android:paddingHorizontal="7dp" android:paddingVertical="2dp"
                    android:background="@drawable/shape_index_circle" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/caret_down" app:tint="#8AA0FF" />
            </LinearLayout>

            <!-- Search -->
            <EditText
                android:id="@+id/campaign_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/ap_search_imported_contacts"
                android:textColorHint="#5A616E"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:background="@drawable/shape_disposition_button"
                android:maxLines="1"
                android:inputType="text"
                android:importantForAutofill="no" />

            <!-- Auto-dialer status (visible only while running) -->
            <TextView
                android:id="@+id/campaign_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:gravity="center"
                android:text=""
                android:textColor="#FFD479"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/shape_btn_gray"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Horizontally scrollable table (header + rows scroll together) -->
        <HorizontalScrollView
            android:id="@+id/campaign_hscroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scrollbars="none"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/campaign_top"
            app:layout_constraintBottom_toTopOf="@id/campaign_footer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Column header -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="7dp"
                    android:background="#161B26">

                    <CheckBox android:id="@+id/campaign_select_all" android:layout_width="44dp"
                        android:layout_height="wrap_content" android:minWidth="0dp" android:buttonTint="#6C8CFF" />
                    <Space android:layout_width="38dp" android:layout_height="1dp" />
                    <TextView style="@style/campaign_col_header" android:layout_width="40dp" android:text="#" android:gravity="center" />
                    <TextView style="@style/campaign_col_header" android:layout_width="150dp" android:text="@string/ap_name" />
                    <TextView style="@style/campaign_col_header" android:layout_width="150dp" android:text="@string/ap_phone" />
                    <TextView style="@style/campaign_col_header" android:layout_width="120dp" android:text="@string/ap_disposition" />
                    <TextView style="@style/campaign_col_header" android:layout_width="114dp" android:text="@string/ap_status" android:gravity="center" />
                    <TextView style="@style/campaign_col_header" android:layout_width="120dp" android:text="@string/ap_last_call" android:gravity="center" />
                    <TextView style="@style/campaign_col_header" android:layout_width="120dp" android:text="@string/ap_actions" android:gravity="center" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/campaign_recycler"
                    android:layout_width="896dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/campaign_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ap_no_contacts_yet_tap_import"
            android:textColor="#5A616E"
            android:textSize="15sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/campaign_top"
            app:layout_constraintBottom_toTopOf="@id/campaign_footer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Footer stats -->
        <LinearLayout
            android:id="@+id/campaign_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#161B26"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_nav_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView android:id="@+id/campaign_total" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/ap_total_0" android:textColor="#C7CDD6" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="  |  " android:textColor="#3A3F47" android:textSize="12sp" />
            <TextView android:id="@+id/campaign_called" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/ap_called_0" android:textColor="#2ECC71" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="  |  " android:textColor="#3A3F47" android:textSize="12sp" />
            <TextView android:id="@+id/campaign_notcalled" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/ap_not_called_0" android:textColor="#E74C3C" android:textSize="12sp" />
        </LinearLayout>

        <!-- Add-contact button (shown on the Contacts screen only; hidden by default) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_plus"
            android:contentDescription="@string/ap_add_contact"
            android:visibility="gone"
            app:tint="#FFFFFF"
            app:backgroundTint="#2D7FF0"
            app:fabSize="normal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/campaign_footer" />

        <include
            android:id="@+id/bottom_nav_bar"
            layout="@layout/bottom_nav_bar"
            app:viewModel="@{viewModel}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
